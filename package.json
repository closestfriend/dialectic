{
  "name": "qloo-hackathon-local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "mlflow:setup": "node scripts/setup-mlflow.mjs",
    "mlflow:server": "uv run --no-project --python .venv-eval/bin/python mlflow server --host 127.0.0.1 --port 5001 --backend-store-uri sqlite:///.local/mlflow/tracking.db --artifacts-destination .local/mlflow/artifacts --default-artifact-root mlflow-artifacts:/ --workers 1",
    "eval:brief": "uv run --no-project --python .venv-eval/bin/python python scripts/evaluate-brief.py",
    "verify:browser": "node scripts/verify-browser.mjs",
    "dev": "node --env-file=.env app/server.mjs",
    "start": "node --env-file=.env app/server.mjs",
    "test": "node --test app/*.test.mjs",
    "mcp:starter": "node --env-file=.env starter/mcp-client/backend.mjs",
    "qloo": "node --env-file=.env node_modules/@qloo/qloo-harness/dist/bin.js",
    "test:connection": "node --env-file=.env scripts/test-connection.mjs"
  },
  "dependencies": {
    "@qloo/qloo-harness": "0.1.26",
    "mlflow-tracing": "0.1.3"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
