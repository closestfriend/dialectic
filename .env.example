QLOO_API_KEY=replace_with_your_key
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
QLOO_HOME=.qloo
# Optional AI model override. Production authenticates to AI Gateway with Vercel OIDC.
# For local synthesis: vercel env pull .env.local, then load it alongside .env.
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
# Optional: start the local collector, then run npm run mlflow:setup.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5001
# MLFLOW_EXPERIMENT_ID=your_local_experiment_id
